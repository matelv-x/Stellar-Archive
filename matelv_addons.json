{
  "schema": 1,
  "addons": [
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "alarm-clock",
      "name": "Alarm Clock",
      "repository": "matelv-x/Alarm-Clock",
      "platforms": ["v4"],
      "detect": {"any": [{"path": "classes/alarm_clock_manager.py"}, {"path": "web/alarm_clock.htm"}]},
      "install": {"argv": ["./install.sh"], "env": {"APP_DIR": "{sg1_root}", "ALARM_CLOCK_MODE": "keep"}, "timeout": 1200},
      "uninstall": {"argv": ["./restore.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "archive_integration_files": ["classes/web_server.py"],
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "aquila-symbol-patch",
      "name": "Aquila Symbol Patch",
      "repository": "matelv-x/Aquila-Symbol-Patch",
      "platforms": ["v4"],
      "detect": {"all": [{"path": "classes/StargateMilkyWay/symbol_manager.py", "contains": "'show_on_web': True"}]},
      "install": {"argv": ["./Aquila.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "uninstall": {"argv": ["./restore-aquila.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "connection-history",
      "name": "Connection History",
      "repository": "matelv-x/Connection-History",
      "platforms": ["v4"],
      "detect": {"all": [{"path": "web/connection_history.htm"}, {"path": "web/js/connection_history.js"}]},
      "install": {"argv": ["./history.sh", "{sg1_root}"], "timeout": 900},
      "uninstall": {"argv": ["./restore-history.sh", "{sg1_root}"], "timeout": 900},
      "archive_integration_files": ["classes/web_server.py", "web/retro/js/navigation.js"],
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "dhd-led-test",
      "name": "DHD LED Test",
      "repository": "matelv-x/DHD-LED-Test",
      "platforms": ["v4"],
      "detect": {"any": [{"path": "test/dhd_test_from_config.py"}, {"path": "web/debug.htm", "contains": "DHD LED TEST UNIVERSAL PATCH START"}]},
      "install": {"argv": ["./install.sh", "{sg1_root}"], "timeout": 1200},
      "uninstall": {"argv": ["./restore.sh", "{sg1_root}"], "timeout": 900},
      "archive_integration_files": ["classes/web_server.py"],
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "dynamic-wormhole",
      "name": "Dynamic Wormhole",
      "repository": "matelv-x/Dynamic-Wormhole",
      "platforms": ["v4"],
      "detect": {"all": [
        {"path": "classes/StargateMilkyWay/wormhole_manager.py", "contains": "DYNAMIC_WORMHOLE_FRAME_SECONDS"},
        {"path": "classes/StargateMilkyWay/wormhole_pattern_manager.py", "contains": "def dynamic_wormhole_step"}
      ]},
      "install": {"argv": ["./install.sh", "{sg1_root}"], "timeout": 1200},
      "uninstall": {"argv": ["./restore.sh", "{sg1_root}"], "timeout": 900},
      "archive_integration_files": ["classes/web_server.py"],
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "lan-discovery",
      "name": "LAN Discovery",
      "repository": "matelv-x/LAN-Discovery",
      "platforms": ["v4"],
      "detect": {"all": [{"path": "classes/stargate_address_book.py", "contains": "lan_gates"}, {"path": "web/retro/js/address_book.js", "contains": "lan"}]},
      "install": {"argv": ["./langate.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "uninstall": {"argv": ["./restore-langate.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "archive_integration_files": ["classes/web_server.py", "web/retro/address_book.html", "web/js/address_book.js"],
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "lamp-mode",
      "name": "Lamp Mode",
      "repository": "matelv-x/Lamp-Mode",
      "platforms": ["v4"],
      "detect": {"any": [{"path": "web/js/debug.js", "contains": "lamp"}, {"path": "classes/web_server.py", "contains": "lamp_mode"}]},
      "install": {"argv": ["./install.sh", "--target", "{sg1_root}"], "timeout": 900},
      "uninstall": {"argv": ["./restore.sh", "--target", "{sg1_root}"], "timeout": 900},
      "archive_integration_files": ["classes/web_server.py"],
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "retro-visuals",
      "name": "Retro Visuals",
      "repository": "matelv-x/Retro-Visuals",
      "platforms": ["v4"],
      "detect": {"all": [{"path": "web/retro/js/retro_visuals.js"}, {"path": "web/retro/visual_settings.html"}]},
      "archive_integration_files": ["classes/web_server.py", "web/retro/address_book.html", "web/retro/js/navigation.js"],
      "install": {"argv": ["./install-retro-visuals.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "uninstall": {"argv": ["./restore-retro-visuals.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "retro-wormhole-animation",
      "name": "Retro Wormhole Animation",
      "repository": "matelv-x/Retro-Wormhole-Animation",
      "platforms": ["v4"],
      "detect": {"all": [{"path": "classes/portal_media_manager.py"}, {"path": "web/retro/js/portal_media.js"}]},
      "install": {"argv": ["./install.sh", "--target", "{sg1_root}", "--install-dependencies"], "timeout": 1200},
      "uninstall": {"argv": ["./restore.sh", "--target", "{sg1_root}"], "timeout": 900},
      "archive_integration_files": ["classes/web_server.py"],
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "sg1-iris",
      "name": "SG1 Iris",
      "repository": "matelv-x/SG1-Iris",
      "platforms": ["v4"],
      "detect": {"all": [{"path": "web/retro/js/iris.js"}, {"path": "web/retro/css/iris.css"}]},
      "install": {"argv": ["./install.sh", "--target", "{sg1_root}"], "timeout": 900},
      "uninstall": {"argv": ["./restore.sh", "--target", "{sg1_root}"], "timeout": 900},
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "silence-mode",
      "name": "Silence Mode",
      "repository": "matelv-x/Silence-Mode",
      "platforms": ["v4"],
      "detect": {"any": [{"path": "web/js/top_menu.js", "contains": "silence_mode"}, {"path": "web/retro/js/navigation.js", "contains": "Silence"}]},
      "install": {"argv": ["./install.sh", "--target", "{sg1_root}"], "timeout": 900},
      "uninstall": {"argv": ["./restore.sh", "--target", "{sg1_root}"], "timeout": 900},
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "stargate-ring-symbols",
      "name": "Stargate Ring Symbols",
      "repository": "matelv-x/Stargate-Ring-Symbols",
      "platforms": ["v4"],
      "detect": {"any": [{"path": "web/retro/dial.html", "contains": "sg1-ring-segment"}, {"path": "web/retro/dial9.html", "contains": "sg1-ring-segment"}]},
      "install": {"argv": ["./apply-ring-symbols-upgrade.sh", "{web_root}"], "timeout": 900},
      "uninstall": {"argv": ["./restore.sh", "{web_root}"], "timeout": 900},
      "restart_required": true
    },
    {
      "maintenance_contract": 1,
      "uninstall_contract": 2,
      "id": "switch-to-retro",
      "name": "Switch To Retro",
      "repository": "matelv-x/Switch-To-Retro",
      "platforms": ["v4"],
      "detect": {"all": [{"path": "web/js/home_redirect.js"}]},
      "install": {"argv": ["./switch-to-retro.sh", "true", "retro/dial.html"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "uninstall": {"argv": ["./restore-switch-to-retro.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
      "archive_integration_files": ["classes/web_server.py", "web/js/address_book.js", "web/retro/js/navigation.js"],
      "restart_required": true
    }
  ]
}
